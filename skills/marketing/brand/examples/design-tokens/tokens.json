{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "neutral": {
      "0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" } },
      "900": { "$value": { "colorSpace": "srgb", "components": [0.0863, 0.0824, 0.0588], "hex": "#16150f" } }
    },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.7059, 0.2706, 0.1216], "hex": "#b4451f" } },
    "bg": { "$value": "{color.neutral.0}", "$description": "Page background." },
    "fg": { "$value": "{color.neutral.900}" },
    "scrim": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5 } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": { "value": 4, "unit": "px" } },
    "4": { "$value": { "value": 1, "unit": "rem" } }
  },
  "radius": { "$type": "dimension", "control": { "$value": { "value": 6, "unit": "px" } } },
  "font": {
    "display": { "$type": "fontFamily", "$value": ["Source Serif 4", "Georgia", "serif"] },
    "weight-bold": { "$type": "fontWeight", "$value": "bold" }
  },
  "type": {
    "$type": "typography",
    "headline": {
      "$value": {
        "fontFamily": "{font.display}",
        "fontSize": { "value": 3.5, "unit": "rem" },
        "fontWeight": 400,
        "letterSpacing": { "value": -0.5, "unit": "px" },
        "lineHeight": 1.05
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "card": {
      "$value": [
        { "color": "{color.scrim}", "offsetX": { "value": 0, "unit": "px" }, "offsetY": { "value": 1, "unit": "px" }, "blur": { "value": 2, "unit": "px" }, "spread": { "value": 0, "unit": "px" } }
      ]
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": { "value": 120, "unit": "ms" } },
    "ease": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] }
  },
  "dark": {
    "color": {
      "$type": "color",
      "bg": { "$value": "{color.neutral.900}" },
      "fg": { "$value": "{color.neutral.0}" },
      "accent": { "$value": { "colorSpace": "srgb", "components": [0.8863, 0.451, 0.2471], "hex": "#e2733f" } }
    }
  }
}
